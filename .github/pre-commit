#!/usr/bin/env python3
import subprocess
import yaml
import re
import os
import sys
import json

exclude_tags = {'private', 'unpublished', 'internal', 'secret'}

# Try to load from config file
config_file = '.git/pre-commit-config.json'
if os.path.exists(config_file):
    try:
        with open(config_file, 'r') as f:
            config = json.load(f)
            exclude_tags = set(config.get('exclude_tags', exclude_tags))
    except (json.JSONDecodeError, IOError):
        pass  # Keep defaults if config file is invalid

def should_exclude(filepath):
    """Check frontmatter for exclusion"""
    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            content = f.read()
        
        match = re.match(r'^---\s*\n(.*?)\n---', content, re.DOTALL)
        if not match:
            return False
        
        frontmatter = yaml.safe_load(match.group(1))
        if not frontmatter:
            return False
        
        # Check draft
        draft = frontmatter.get('draft')
        if draft is True or str(draft).lower() in ('true', 'yes', '1'):
            return True
        
        # Check tags
        tags = frontmatter.get('tags', [])
        
        if isinstance(tags, list):
            if any(str(tag).lower() in exclude_tags for tag in tags):
                return True
        elif isinstance(tags, str):
            if any(tag.strip().lower() in exclude_tags for tag in tags.split(',')):
                return True
                
    except Exception as e:
        # Optional: print(f"Error parsing {filepath}: {e}")
        pass
    
    return False

def main():
    # Get staged files - ONE PER LINE
    result = subprocess.run(
        ['git', 'diff', '--cached', '--name-only'],
        capture_output=True,
        text=True,
        encoding='utf-8'
    )
    
    if result.returncode != 0:
        return 0
    
    # Split by newlines, not whitespace!
    staged_files = []
    for line in result.stdout.strip().split('\n'):
        if line and line.strip():  # Not empty
            staged_files.append(line.strip())
    
    print(f"Found {len(staged_files)} staged file(s)")
    
    excluded_files = []
    
    for filepath in staged_files:
        # Only check .md files
        if not filepath.lower().endswith('.md'):
            continue
        
        if not os.path.exists(filepath):
            print(f"  ⚠️  File doesn't exist: {filepath}")
            continue
        
        if should_exclude(filepath):
            # Unstage this file
            subprocess.run(
                ['git', 'reset', '--', filepath],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            excluded_files.append(filepath)
            print(f"  🚫 Excluding: {filepath}")
        else:
            print(f"  ✅ Keeping: {filepath}")
    
    if excluded_files:
        print(f"\n🚫 Total excluded: {len(excluded_files)} file(s)")
        for f in excluded_files:
            print(f"   - {f}")
        print("\n(Files with draft:true or private/unpublished tags remain locally)")
    
    return 0

if __name__ == '__main__':
    sys.exit(main())